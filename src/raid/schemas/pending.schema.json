{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pending.json",
  "description": "Proposals awaiting a decision in raid review. The contract is defined in SPEC-EPIC-1-05; dates must also be real calendar dates, which the validator checks.",
  "type": "object",
  "required": [
    "proposals"
  ],
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "description",
          "owner",
          "severity",
          "due_date",
          "source_excerpt"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "Risk",
              "Assumption",
              "Issue",
              "Dependency"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
            }
          },
          "description": {
            "type": "string",
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]|\\r(?!\\n)"
            }
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "not": {
              "type": "string",
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
            }
          },
          "severity": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "not": {
              "type": "string",
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
            }
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]|\\r(?!\\n)"
            }
          },
          "source_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "not": {
              "type": "string",
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]"
            }
          }
        }
      }
    }
  }
}
